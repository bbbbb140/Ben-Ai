body{
margin:0;
font-family:Arial;
background:#202123;
color:white;
}

.app{
display:flex;
height:100vh;
}

.sidebar{
width:250px;
background:#111;
padding:10px;
}

.chat{
flex:1;
display:flex;
flex-direction:column;
}

#chat{
flex:1;
overflow:auto;
padding:10px;
}

.input{
display:flex;
gap:10px;
padding:10px;
background:#2a2b32;
}

button{
background:#19c37d;
border:none;
padding:8px;
border-radius:6px;
color:white;
cursor:pointer;
}

input{
padding:6px;
border-radius:5px;
border:none;
}
